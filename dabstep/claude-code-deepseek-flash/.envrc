source_up
# Where tp's cost proxy forwards this arm's Anthropic-format requests. tp points
# the solution's ANTHROPIC_BASE_URL at the proxy; this value is the proxy's
# upstream. Setting it inside solution.py instead would bypass the proxy and
# the run would record no cost.
export ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# The harness, as the board names it: a site-graded run that declares no name
# is listed as "<model> · <agent>", and tp reports TRAP_AGENT as that agent.
export TRAP_AGENT=claude-code
