# Keys for every arm, read from moderation_calibration/.env (gitignored via
# the monorepo-level .gitignore; start from .env.example). tp's cost proxy
# only meters a vendor whose key is already in the shell that runs `tp run`,
# so the keys are loaded here and never inside solution.py.
dotenv_if_exists

# The task's grading pack is bound on uat.trapstreet.run only -- the
# trapstreet.run (production) registration exists but its private pack
# bind is blocked pending Zhuaiz (see the assertUat() safety check in
# trapstreet-web's bind-grading-pack.ts). Submitting without this points at
# an unbound task and will not grade.
export TRAPSTREET_URL=https://uat.trapstreet.run
