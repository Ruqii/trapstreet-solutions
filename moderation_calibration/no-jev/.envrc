# Where tp's cost proxy forwards this arm's Anthropic-format requests.
export ANTHROPIC_BASE_URL=https://api.anthropic.com
# The harness, as the board names it: a site-graded run that declares no
# name is listed as "<model> · <agent>", and tp reports TRAP_AGENT as that
# agent.
export TRAP_AGENT=no-jev
